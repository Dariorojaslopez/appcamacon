# Plantilla — copie este archivo como ".env" en la raíz del proyecto y ajuste valores.
# El archivo real ".env" no se versiona (está en .gitignore).

# Base de datos
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/NOMBRE_BD?schema=public"

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=10h
JWT_REFRESH_EXPIRES_IN=7d

# ─── SharePoint / OneDrive (recomendado en producción) ───────────────────────
# NO use usuario/contraseña de SharePoint en el .env. Se requiere una app en Azure AD:
# Azure Portal → Microsoft Entra ID → App registrations → New → anote Tenant ID, Client ID,
# Certificates & secrets → New client secret. API permissions → Microsoft Graph → Application:
#   Files.ReadWrite.All (y Sites.ReadWrite.All si la carpeta es en SharePoint, no OneDrive personal).
# Grant admin consent. Comparta la carpeta de documentos con la cuenta de servicio o permisos de app.
ONEDRIVE_ENABLED=true
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
# Carpeta por defecto si la obra no tiene enlace propio (enlace "Compartir" de SharePoint/OneDrive)
ONEDRIVE_FOLDER_SHARE_URL=

# Dictado por voz: en `next dev` las IPs privadas (ej. 192.168.x.x) ya no bloquean en la app; en el celular use:
#   npm run dev:https  →  https://192.168.x.x:3000 (aviso de certificado autofirmado = normal)
# Opcional, orígenes extra: NEXT_PUBLIC_VOICE_INSECURE_DEV_ORIGINS=http://...

# ─── Google Drive (alternativa; desactivar en producción si usa SharePoint) ───
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_REDIRECT_URI=https://appinformediario.camacon.com.co/auth/google/callback
GOOGLE_DRIVE_SCOPE=
GOOGLE_DRIVE_FOLDER_ID=
